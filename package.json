{
  "name": "thread-func",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dominicvonk/thread-func.git"
  },
  "description": "A simple library to run functions in a separate thread. Supports Node.js, Deno, and Bun.",
  "main": "dist/thread-func.js",
  "type": "module",
  "module": "dist/thread-func.js",
  "types": "dist/thread-func.d.ts",
  "exports": {
    ".": {
      "types": "./dist/thread-func.d.ts",
      "import": "./dist/thread-func.js",
      "default": "./dist/thread-func.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && npm run test:vitest && npm run test:runtime",
    "test:vitest": "tsc -p tsconfig.fixtures.json && tsc -p tsconfig.tests.json && vitest run --pool=threads && vitest run --pool=forks",
    "test:runtime": "node tests/test.mjs"
  },
  "author": "Dominic Vonk <dominic@vonk.io>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "serialize-error": "^11.0.3"
  },
  "files": [
    "dist/*",
    "README.md",
    "package.json",
    "package-lock.json",
    "deno.json"
  ]
}
